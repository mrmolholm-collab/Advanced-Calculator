<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="460.0" prefWidth="350.0" spacing="20.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dk.sea.advancedcalculator.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <HBox prefHeight="100.0" prefWidth="200.0">
      <children>
         <TextField fx:id="txtDisplay" prefHeight="100.0" prefWidth="327.0" />
      </children>
   </HBox>
   <HBox prefHeight="44.0" prefWidth="310.0">
      <children>
         <Button fx:id="btnDelete" minHeight="-Infinity" minWidth="-Infinity" mnemonicParsing="false" onAction="#OnbtnDeleteClicked" prefHeight="40.0" prefWidth="70.0" text="Del">
            <HBox.margin>
               <Insets right="10.0" />
            </HBox.margin>
         </Button>
         <Button fx:id="btnAllClear" minWidth="-Infinity" mnemonicParsing="false" onAction="#OnbtnAllClearClicked" prefHeight="40.0" prefWidth="70.0" text="AC">
            <HBox.margin>
               <Insets right="10.0" />
            </HBox.margin>
         </Button>
         <Button fx:id="btnPercent" mnemonicParsing="false" onAction="#OnbtnPercentClicked" prefHeight="40.0" prefWidth="70.0" text="\%">
            <HBox.margin>
               <Insets right="10.0" />
            </HBox.margin>
         </Button>
         <Button fx:id="btnDivide" mnemonicParsing="false" onAction="#OnbtnDivideClicked" prefHeight="40.0" prefWidth="70.0" text="/" />
      </children>
   </HBox>
   <HBox prefHeight="39.0" prefWidth="310.0">
      <children>
         <Button fx:id="btn7" minHeight="-Infinity" minWidth="-Infinity" mnemonicParsing="false" onAction="#Onbtn7Clicked" prefHeight="40.0" prefWidth="70.0" text="7">
            <HBox.margin>
               <Insets right="10.0" />
            </HBox.margin>
         </Button>
         <Button fx:id="btn8" minHeight="-Infinity" minWidth="-Infinity" mnemonicParsing="false" onAction="#Onbtn8Clicked" prefHeight="40.0" prefWidth="70.0" text="8">
            <HBox.margin>
               <Insets right="10.0" />
            </HBox.margin>
         </Button>
         <Button fx:id="btn9" minHeight="-Infinity" minWidth="-Infinity" mnemonicParsing="false" onAction="#Onbtn9Clicked" prefHeight="40.0" prefWidth="70.0" text="9">
            <HBox.margin>
               <Insets right="10.0" />
            </HBox.margin>
         </Button>
         <Button fx:id="btnMultiply" minHeight="-Infinity" minWidth="-Infinity" mnemonicParsing="false" onAction="#OnbtnMultiplyClicked" prefHeight="40.0" prefWidth="70.0" text="X" />
      </children>
      <VBox.margin>
         <Insets />
      </VBox.margin>
   </HBox>
   <HBox prefHeight="44.0" prefWidth="310.0">
      <children>
         <Button fx:id="btn4" minHeight="-Infinity" minWidth="-Infinity" mnemonicParsing="false" onAction="#Onbtn4Clicked" prefHeight="40.0" prefWidth="70.0" text="4">
            <HBox.margin>
               <Insets right="10.0" />
            </HBox.margin>
         </Button>
         <Button fx:id="btn5" mnemonicParsing="false" onAction="#Onbtn5Clicked" prefHeight="40.0" prefWidth="70.0" text="5">
            <HBox.margin>
               <Insets right="10.0" />
            </HBox.margin>
         </Button>
         <Button fx:id="btn6" mnemonicParsing="false" onAction="#Onbtn6Clicked" prefHeight="40.0" prefWidth="70.0" text="6">
            <HBox.margin>
               <Insets right="10.0" />
            </HBox.margin>
         </Button>
         <Button fx:id="btnMinus" mnemonicParsing="false" onAction="#OnbtnMinusClicked" prefHeight="40.0" prefWidth="70.0" text="-" />
      </children>
   </HBox>
   <HBox prefHeight="20.0" prefWidth="310.0">
      <children>
         <Button fx:id="btn1" minHeight="-Infinity" minWidth="-Infinity" mnemonicParsing="false" onAction="#Onbtn1Clicked" prefHeight="40.0" prefWidth="70.0" text="1">
            <HBox.margin>
               <Insets right="10.0" />
            </HBox.margin>
         </Button>
         <Button fx:id="btn2" minHeight="-Infinity" minWidth="-Infinity" mnemonicParsing="false" onAction="#Onbtn2Clicked" prefHeight="40.0" prefWidth="70.0" text="2">
            <HBox.margin>
               <Insets right="10.0" />
            </HBox.margin>
         </Button>
         <Button fx:id="btn3" minHeight="-Infinity" minWidth="-Infinity" mnemonicParsing="false" onAction="#Onbtn3Clicked" prefHeight="40.0" prefWidth="70.0" text="3">
            <HBox.margin>
               <Insets right="10.0" />
            </HBox.margin>
         </Button>
         <Button fx:id="btnPlus" minHeight="-Infinity" minWidth="-Infinity" mnemonicParsing="false" onAction="#OnbtnPlusClicked" prefHeight="40.0" prefWidth="70.0" text="+" />
      </children>
   </HBox>
   <HBox prefHeight="20.0" prefWidth="310.0">
      <children>
         <Button fx:id="btnPlusMinus" minHeight="-Infinity" minWidth="-Infinity" mnemonicParsing="false" onAction="#OnbtnPlusMinusClicked" prefHeight="40.0" prefWidth="70.0" text="+-">
            <HBox.margin>
               <Insets right="10.0" />
            </HBox.margin>
         </Button>
         <Button fx:id="btn0" minHeight="-Infinity" minWidth="-Infinity" mnemonicParsing="false" onAction="#Onbtn0Clicked" prefHeight="40.0" prefWidth="70.0" text="0">
            <HBox.margin>
               <Insets right="10.0" />
            </HBox.margin>
         </Button>
         <Button fx:id="btnComma" minHeight="-Infinity" minWidth="-Infinity" mnemonicParsing="false" onAction="#OnbtnCommaClicked" prefHeight="40.0" prefWidth="70.0" text=",">
            <HBox.margin>
               <Insets right="10.0" />
            </HBox.margin>
         </Button>
         <Button fx:id="btnEqual" minHeight="-Infinity" minWidth="-Infinity" mnemonicParsing="false" onAction="#OnbtnEqualClicked" prefHeight="40.0" prefWidth="70.0" text="=" />
      </children>
   </HBox>
</VBox>
